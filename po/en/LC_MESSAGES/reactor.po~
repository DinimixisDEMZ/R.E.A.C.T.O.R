#: app.py:262
msgid ""
"<p>R.E.A.C.T.O.R 1.0 — Primera versión estable.</p>\n"
"<ul>\n"
"  <li>Tests automatizados (49 tests cubriendo scoring, benchmark, database y "
"thermal).</li>\n"
"  <li>Split del módulo automatización en 4 submódulos.</li>\n"
"  <li>Refactorización del god-object VentanaSimple con dataclasses de estado."
"</li>\n"
"  <li>pyproject.toml con configuración estándar de Python.</li>\n"
"  <li>Constantes compartidas centralizadas en core/constantes.py.</li>\n"
"  <li>35 excepciones genéricas reemplazadas por tipos específicos.</li>\n"
"  <li>Scoring renombrado: fairness → waste para mayor claridad.</li>\n"
"</ul>"
msgstr ""
"<p>R.E.A.C.T.O.R 1.0 — First stable release.</p>\n"
"<ul>\n"
"  <li>Automated tests (49 tests covering scoring, benchmark, database and "
"thermal).</li>\n"
"  <li>Split of the automation module into 4 submodules.</li>\n"
"  <li>Refactoring of the god-object VentanaSimple with state dataclasses.</"
"li>\n"
"  <li>pyproject.toml with standard Python configuration.</li>\n"
"  <li>Centralized shared constants in core/constantes.py.</li>\n"
"  <li>35 generic exceptions replaced with specific types.</li>\n"
"  <li>Scoring renamed: fairness → waste for clarity.</li>\n"
"</ul>"

