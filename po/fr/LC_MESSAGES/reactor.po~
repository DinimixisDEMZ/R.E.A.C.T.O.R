#: app.py:262
msgid ""
"<p>R.E.A.C.T.O.R 1.0 — Primera versión estable.</p>\n"
"<ul>\n"
"  <li>Tests automatizados (49 tests cubriendo scoring, benchmark, database y "
"thermal).</li>\n"
"  <li>Split del módulo automatización en 4 submódulos.</li>\n"
"  <li>Refactorización del god-object VentanaSimple con dataclasses de estado."
"</li>\n"
"  <li>pyproject.toml con configuración estándar de Python.</li>\n"
"  <li>Constantes compartidas centralizadas en core/constantes.py.</li>\n"
"  <li>35 excepciones genéricas reemplazadas por tipos específicos.</li>\n"
"  <li>Scoring renombrado: fairness → waste para mayor claridad.</li>\n"
"</ul>"
msgstr ""
"<p>R.E.A.C.T.O.R 1.0 — Première version stable.</p>\n"
"<ul>\n"
"  <li>Tests automatisés (49 tests couvrant le scoring, le benchmark, la base "
"de données et le thermique).</li>\n"
"  <li>Division du module d'automatisation en 4 sous-modules.</li>\n"
"  <li>Refactorisation du god-object VentanaSimple avec des dataclasses "
"d'état.</li>\n"
"  <li>pyproject.toml avec configuration standard de Python.</li>\n"
"  <li>Constantes partagées centralisées dans core/constantes.py.</li>\n"
"  <li>35 exceptions génériques remplacées par des types spécifiques.</li>\n"
"  <li>Scoring renommé : fairness → waste pour plus de clarté.</li>\n"
"</ul>"

